# `burxt fetch` writes these; the LOCKFILE is committed, not the checkout.
.burxt/

# Build output. `web/*.wasm` is generated too, but committed on purpose — the site serves it,
# and a page that needs a build step to be viewable is a page nobody views.
build/

# `star-check` writes one of these beside every document it checks.
*.check.bx

# Andre's golden rules, and how this work is run. Local on purpose — the same file in every
# repository in the family.
.claude/
