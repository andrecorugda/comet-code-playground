// Everything the playground computes, in Burxt. No JavaScript decides anything here.
use "star/star.bx";
use "bmx/burxt/bmx.bx";
use "std/string.bx";
use "std/json.bx";

external function host_result(text: String) -> CInt;

// star: a document becomes a component, or a refusal naming what is wrong.
function play(source: String) -> Int {
    region frame {
        let mutable out: String = "";
        match star_generate(source, "demo", []) {
            Error(message) => { out = message; }
            Ok(built) => { out = star_source_of(built, "demo"); }
        }
        let sent: Int = host_result(out);
        return len(out);
    }
}

// BMX: a document and a JSON scope become a page, or a refusal with its offset.
//
// **`bmx_to_html` is the format's own renderer, in Burxt.** The first version of this playground
// imported BMX's JavaScript reference implementation. It worked, and it was the wrong instinct: the
// Burxt implementation was already a dependency, already conformance-tested, and needs no host.
//
// **And the scope is JSON, walked by matching on `Json` itself.** The version before this used
// `name: value` lines and said `std/json.bx` could not enumerate an object — which was wrong, and
// wrong in a way worth recording: `json_at`, `json_as_text` and `json_as_int` all take a name or
// return a scalar, so the FUNCTION surface implies named access is the only door. The capability is in
// the type. `Object([Field])` is public and `Field.name` reads straight off, so a program can walk a
// structure whose shape it did not write. Reading a surface is not testing a surface.
function render(source: String, scope: String) -> Int {
    region frame {
        let mutable binds: [Binding] = [];
        let mutable failed: String = "";
        if len(string_trim(scope)) > 0 {
            match json_parse(scope) {
                Error(e) => { failed = "The values pane is not valid JSON. " + e; }
                Ok(v) => {
                    match v {
                        Object(fields) => {
                            let mutable i: Int = 0;
                            while i < len(fields) {
                                match fields[i].value {
                                    Text(t) => { let a: Int = push(binds, bmx_bind(fields[i].name, t)); }
                                    Number(d) => {
                                        let b: Int = push(binds, bmx_bind(fields[i].name, d));
                                    }
                                    Truth(yes) => {
                                        let mutable said: String = "false";
                                        if yes { said = "true"; }
                                        let c: Int = push(binds, bmx_bind(fields[i].name, said));
                                    }
                                    // A slot holds one value, so a nested structure has no spelling here.
                                    // Named rather than skipped: a binding silently missing is the thing
                                    // BMX refuses documents for.
                                    Object(o) => { failed = "`" + fields[i].name + "` is an object, and a slot takes one value."; }
                                    List(l) => { failed = "`" + fields[i].name + "` is a list, and a slot takes one value."; }
                                    Null => { let d2: Int = push(binds, bmx_bind(fields[i].name, "")); }
                                }
                                i += 1;
                            }
                        }
                        Null => { } Truth(b2) => { } Number(n2) => { } Text(t2) => { } List(l2) => { }
                    }
                }
            }
        }
        if len(failed) > 0 {
            let told: Int = host_result(failed);
            return 0;
        }
        let mutable out: String = "";
        match bmx_to_html(source, binds) {
            Error(message) => { out = message; }
            Ok(html) => { out = html; }
        }
        let sent: Int = host_result(out);
        return len(out);
    }
}
